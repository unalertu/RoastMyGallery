# Copy to .env for local development (`vercel dev` picks it up).
# Get a key at https://aistudio.google.com/apikey — free tier is fine.
# In production, set this in the Vercel dashboard or via `vercel env add`.
GEMINI_API_KEY=your-gemini-api-key-here

# Anti-abuse gate: must match `appSharedSecret` in
# RoastMyGallery/App/AppConfig.swift. If unset, the check is skipped
# (fail-open) with a console warning.
APP_SHARED_SECRET=your-shared-secret-here

# Optional: daily request budget (default 800 ≈ 80% of Gemini free tier).
# DAILY_REQUEST_CAP=800

# RevenueCat Virtual Currency (credits). Required for /api/spend,
# /api/starter-grant, and the credit deduction folded into /api/insight.
# The SECRET key must live ONLY here (server-side), never in the iOS app.
# Until both are set, credit adjustments are skipped (fail-open) with a warning.
#   - Secret key:  RevenueCat dashboard → Project settings → API keys → Secret
#   - Project ID:  RevenueCat dashboard → Project settings (the proj... value)
REVENUECAT_SECRET_KEY=REVENUECAT_SECRET_KEY_PLACEHOLDER
REVENUECAT_PROJECT_ID=REVENUECAT_PROJECT_ID_PLACEHOLDER
